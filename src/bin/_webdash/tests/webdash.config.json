{
    "dependencies": [
        "$.rootDir()/src/bin/_webdash/tests/createby-profile-dep",
        "$.rootDir()/src/bin/_webdash/tests/clonedby-profile-dep"
    ],
    "commands": [
        {
            "name": "prerequisites",
            "silent": true,
            "test-case": "Prerequisites compiled.",
            "actions": [
                "cd $.thisDir()/framework-logging && npx tsc"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "all",
            "silent": true,
            "actions": [
                ":prerequisites",
                ":all-fast"
            ],
            "exit-actions": [
                {
                    "0": [
                        "echo 'All tests completed successfully. Performing cleanup:'",
                        ":cleanup"
                    ]
                },
                {
                    "*": [
                        "echo 'Some test(s) failed. Performing cleanup:'",
                        ":cleanup"
                    ]
                }
            ]
        },
        {
            "name": "all-fast",
            "silent": true,
            "test-case": "All tests run.",
            "actions": [
                ":test-success-dependency",
                ":test-rootdir-value",
                ":test-webdash-storage-substitutions",
                ":test-action-dependency",
                ":test-heartbeat-log",
                "webdash :condition-port-pass",
                "webdash condition-port-used",
                "webdash condition-port-used-fail",
                ":failed-command",
                "./clonedby-profile-dep:all",
                ":test-logging-all",
                ":test-invalid-user-via-server"
            ]
        },
        {
            "name": "test-success-dependency",
            "silent": true,
            "test-case": "Dependencies exist/created.",
            "actions": [
                "test -d $.rootDir()/src/bin/_webdash/tests/createby-profile-dep",
                "test -d $.rootDir()/src/bin/_webdash/tests/clonedby-profile-dep"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "cleanup",
            "silent": true,
            "test-case": "Cleanup completed.",
            "actions": [
                "rm -rf $.rootDir()/src/bin/_webdash/tests/createby-profile-dep",
                "rm -rf $.rootDir()/src/bin/_webdash/tests/clonedby-profile-dep",
                "rm -f $.thisDir()/dummy-test-file.txt"
            ]
        },
        {
            "name": "test-rootdir-value",
            "silent": true,
            "test-case": "webdash.rootDir value is correct ($#.webdash.rootDir).",
            "actions": [
                "bash -c '[ $#.webdash.rootDir = this ] || exit 1'"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "test-webdash-storage-substitutions",
            "silent": true,
            "test-case": "$.webdash temporary/persistent substitutions resolve correctly.",
            "actions": [
                "test \"$.webdash.temporary()\" = \"$.rootDir()/app-temporary/bin/_webdash\"",
                "test \"$.webdash.persistent()\" = \"$.rootDir()/app-persistent/bin/_webdash\""
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "dependencies"
        },
        {
            "name": "create-dummy-test-file",
            "silent": true,
            "test-case": "Dummy test file created.",
            "action": "echo 'This is a dummy test file.' > $.thisDir()/dummy-test-file.txt",
            "wdir": "$.thisDir()"
        },
        {
            "name": "test-action-dependency",
            "silent": true,
            "test-case": "Action-created file exists.",
            "actions": [
                "test -f $.thisDir()/dummy-test-file.txt"
            ],
            "dependencies": [
                ":create-dummy-test-file"
            ],
            "wdir": "$.thisDir()"
        },
        {
            ".comment": "Tests for the heartbeat module. Will update log file.",
            "name": "test-heartbeat-binary",
            "silent": true,
            "test-case": "Heartbeat binary responds.",
            "actions": [
                "webdash-heartbeat | grep -q 'Heartbeat:'"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "test-heartbeat-log",
            "silent": true,
            "test-case": "Heartbeat log entry is within the last hour.",
            "actions": [
                "test -f $.rootDir()/app-temporary/logging/webdash-heartbeat/logging.info.txt",
                "last_log=$(tail -1 $.rootDir()/app-temporary/logging/webdash-heartbeat/logging.info.txt | grep -oP '\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}' | head -1) && log_epoch=$(date -d \"$last_log\" +%s) && now_epoch=$(date +%s) && diff=$((now_epoch - log_epoch)) && [ $diff -lt 3600 ] && [ $diff -ge 0 ]"
            ],
            "exit-actions": [
                {
                    "*": [
                        "echo 'WARNING: Heartbeat test skipped (service may not be running).'"
                    ],
                    "return": 0
                }
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "condition-port-pass",
            "silent": true,
            "test-case": "Port 65535 is unused as expected.",
            "condition": "$.isPortUnused(65535)",
            "actions": [],
            "actions-else": [
                "exit 1"
            ]
        },
        {
            "name": "condition-port-used",
            "condition": "!$.isPortUnused(22)",
            "silent": true,
            "test-case": "Port 22 is used as expected (with negation/else-flow).",
            "actions": [],
            "actions-else": [
                "exit 1"
            ]
        },
        {
            "name": "condition-port-used-fail",
            "condition": "$.isPortUnused(22)",
            "silent": true,
            "test-case": "Port 22 is used as expected (with else-flow).",
            "actions": [
                "exit 1"
            ],
            "actions-else": []
        },
        {
            "name": "failed-command",
            "silent": true,
            "test-case": "Command fails as expected.",
            "actions": [
                "ech o'This should fail.'"
            ],
            "exit-actions": [
                {
                    "0": [
                        "echo 'Test [failed]: failed-command exited with zero.'"
                    ],
                    "return": 1
                },
                {
                    "*": [
                        "echo 'Test [passed]: failed-command exited with non-zero as expected.'"
                    ],
                    "return": 0
                }
            ]
        },
        {
            "name": "test-invalid-user-via-server",
            "silent": true,
            "actions": [
                "./server-tests:test-invalid-user-via-server"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "test-logging-all",
            "silent": true,
            "actions": [
                "./framework-logging:all"
            ]
        }
    ]
}
