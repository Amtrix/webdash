{
    "commands": [
        {
            "name": "clean",
            "action": "rm -f build/webdash-heartbeat",
            "wdir": "$.thisDir()"
        },
        {
            "name": "build",
            "actions": [
                "mkdir -p build",
                "cmake -B./build -H./ -S./",
                "make -C build"
            ],
            "dependencies": [
                "$.rootDir()/src/lib/_webdash/executor/webdash.config.json:build"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "install",
            "action": "bash install.sh",
            "wdir": "$.thisDir()"
        },
        {
            "name": "all",
            "actions": [
                ":clean",
                ":build",
                ":install"
            ],
            "wdir": "$.thisDir()"
        },
        {
            "name": "heartbeat",
            "action": "webdash-heartbeat",
            "frequency": "60000",
            "wdir": "$.thisDir()"
        }
    ]
}
