{
    "webdash": {
        "rootDir": "this",
        ".field-comment": "Identifies that this webdash-profile.json file is at root"
    },
    "env": {
        "WEBDASH": "$.rootDir()"
    },
    "ports": {
        "src-static-wallpaper-engine-dashboard-monitor": "8765"
    },
    "path-add": [
        "$.rootDir()/app-persistent/bin",
        "$.rootDir()/app-persistent/bin/_webdash"
    ],
    "modules": [
        {
            "path": "$.rootDir()/src/static/wallpaper-tasks",
            "git": "git@github.com:Amtrix/src-static-wallpaper-tasks.git"
        },
        {
            "path": "$.rootDir()/src/lib/webdash-executor",
            "git": "git@github.com:Amtrix/src-lib-webdash-executor.git"
        },
        {
            "path": "$.rootDir()/src/bin/_webdash-heartbeat",
            "git": "git@github.com:Amtrix/src-bin-_webdash-heartbeat.git"
        },
        {
            "path": "$.rootDir()/src/bin/_webdash-server",
            "git": "git@github.com:Amtrix/src-bin-_webdash-server.git"
        },
        {
            "path": "$.rootDir()/src/bin/report-build-state",
            "git": "git@github.com:Amtrix/src-bin-report-build-state.git"
        }
    ],
    "dependencies": [
        {
            "path": "$.rootDir()/src/lib/external/json",
            "git": "git@github.com:nlohmann/json.git"
        },
        {
            "path": "$.rootDir()/src/lib/external/websocketpp",
            "git": "git@github.com:zaphoyd/websocketpp.git",
            "branch": "develop"
        }
    ]
}
