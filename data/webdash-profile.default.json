{
    "webdash": {
        "rootDir": "this",
        ".field-comment": "Identifies that this webdash-profile.json file is at root"
    },
    "env": {
        "WEBDASH": "$.rootDir()"
    },
    "ports": {
        "src-static-wallpaper-engine-dashboard-monitor": "8765"
    },
    "path-add": [
        "$.rootDir()/app-persistent/bin",
        "$.rootDir()/app-persistent/bin/_webdash"
    ],
    "modules": [
        {
            "path": "$.rootDir()/src/static/wallpaper-tasks",
            "git": "git@github.com:Amtrix/src-static-wallpaper-tasks.git"
        },
        {
            "path": "$.rootDir()/src/bin/report-build-state",
            "git": "git@github.com:Amtrix/src-bin-report-build-state.git"
        },
        {
            "path": "$.rootDir()/src/bin/_webdash/tests/clonedby-profile-dep",
            "git": "git@github.com:Amtrix/src-bin-_webdash-tests-clonechk.git"
        }
    ],
    "dependencies": [
        {
            "path": "$.rootDir()/src/lib/external/json",
            "git": "git@github.com:nlohmann/json.git"
        },
        {
            "path": "$.rootDir()/src/lib/external/websocketpp",
            "git": "git@github.com:zaphoyd/websocketpp.git",
            "branch": "develop"
        },
        {
            "path": "$.rootDir()/src/lib/external/android-sdk",
            "actions": [
                "curl -o cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip",
                "unzip -q cmdline-tools.zip",
                "mkdir -p cmdline-tools/latest",
                "mv cmdline-tools/* cmdline-tools/latest/ 2>/dev/null || true",
                "rm -f cmdline-tools.zip",
                "yes | cmdline-tools/latest/bin/sdkmanager --licenses",
                "cmdline-tools/latest/bin/sdkmanager 'platform-tools' 'platforms;android-34' 'build-tools;34.0.0'"
            ]
        },
        {
            "path": "$.rootDir()/src/bin/_webdash/tests/createby-profile-dep",
            "wdir": "$.path()",
            "actions": [
                "[ -d $.path() ] || { echo 'FAIL: Directory was not created'; exit 1; }"
            ]
        }
    ]
}
